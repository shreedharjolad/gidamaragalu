---
import Dashboard from "../components/Dashboard.astro";
import Legend from "../components/Legend.astro";
import Filters from "../components/Filters.astro";
import MapView from "../components/MapView.astro";
import Login from "../components/Login.astro";
---

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>

<h1>GreenStreet</h1>

<Login />

<Dashboard />

<div class="analytics">

  <div id="healthy-card"></div>

  <div id="water-card"></div>

  <div id="broken-card"></div>

  <div id="pest-card"></div>

  <div id="illegal-card"></div>

</div>

<h2>Top Guardians</h2>

<div id="leaderboard">
Loading...
</div>

<Legend />

<Filters />

<div class="toolbar">

  <input
    id="species"
    type="text"
    placeholder="Tree species"
  />

  <div id="selected-location">
    Click on map to select location
  </div>

  <div id="message"></div>

  <input
    id="latitude"
    type="hidden"
  />

  <input
    id="longitude"
    type="hidden"
  />

  <button
    id="save-tree"
    type="button"
  >
    Add Tree
  </button>

</div>

<MapView />

<style>

/* ---------- Base ---------- */

:global(*) {
  box-sizing: border-box;
}

:global(html) {
  width: 100%;
  overflow-x: hidden;
}

:global(body) {
  margin: 0;
  width: 100%;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f7f8f7;
  color: #222;
}

h1 {
  margin: 0;
  padding: 1rem;
  text-align: center;
}

h2 {
  padding: 0 1rem;
}

/* ---------- Analytics ---------- */

.analytics {
  display: grid;
  grid-template-columns: repeat(5, minmax(140px, 1fr));
  gap: 12px;
  margin: 1rem;
}

.analytics div {
  border: 1px solid #ccc;
  border-radius: 8px;
  padding: 12px;
  min-width: 0;
  background: white;
}

/* ---------- Leaderboard ---------- */

#leaderboard {
  margin: 0 1rem 1rem;
  padding: 12px;
  background: white;
  border-radius: 8px;
  border: 1px solid #ddd;
}

/* ---------- Toolbar ---------- */

.toolbar {
  margin: 1rem;
  padding: 12px;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
  background: white;
  border-radius: 8px;
  border: 1px solid #ddd;
}

.toolbar input[type="text"] {
  flex: 1 1 220px;
  min-width: 0;
  padding: 10px;
  font-size: 16px;
}

#selected-location {
  font-weight: bold;
  flex: 1 1 220px;
}

#message {
  width: 100%;
  min-height: 24px;
  font-weight: bold;
}

button {
  padding: 10px 14px;
  cursor: pointer;
  font-size: 16px;
  border-radius: 6px;
  border: 1px solid #aaa;
  background: white;
}

/* Important for mobile touch targets */
button,
input {
  min-height: 44px;
}

.error {
  color: red;
}

.success {
  color: green;
}

/* ---------- Mobile ---------- */

@media (max-width: 768px) {

  h1 {
    font-size: 1.6rem;
    padding: 0.75rem;
  }

  h2 {
    font-size: 1.25rem;
    margin-top: 1rem;
  }

  .analytics {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin: 0.75rem;
  }

  .analytics div {
    padding: 10px;
    text-align: center;
    font-size: 14px;
  }

  #leaderboard {
    margin: 0 0.75rem 0.75rem;
  }

  .toolbar {
    margin: 0.75rem;
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .toolbar input[type="text"],
  #selected-location,
  #message,
  .toolbar button {
    width: 100%;
    flex: none;
  }

  .toolbar button {
    min-height: 48px;
    font-size: 16px;
  }
}

/* ---------- Very small phones ---------- */

@media (max-width: 400px) {

  .analytics {
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin: 0.5rem;
  }

  .analytics div {
    font-size: 13px;
    padding: 8px;
  }

}

</style>

<script>

window.addEventListener("load", () => {

  document
    .getElementById("save-tree")
    .addEventListener("click", async () => {

      const message =
        document.getElementById("message");

      message.textContent = "";
      message.className = "";

      const species =
        document.getElementById("species").value;

      if (
        !species ||
        species.trim().length === 0
      ) {

        message.textContent =
          "Please enter tree species.";

        message.className =
          "error";

        document
          .getElementById("species")
          .focus();

        return;
      }

      const latitude =
        parseFloat(
          document.getElementById("latitude").value
        );

      const longitude =
        parseFloat(
          document.getElementById("longitude").value
        );

      if (
        isNaN(latitude) ||
        isNaN(longitude)
      ) {

        message.textContent =
          "Please click on the map first.";

        message.className =
          "error";

        return;
      }

      try {

        const token = localStorage.getItem("token");

        const response =
          await fetch(
            "/api/trees",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
              },
              body: JSON.stringify({
                species,
                latitude,
                longitude
              })
            }
          );

        if (response.ok) {

          message.textContent =
            "Tree added successfully.";

          message.className =
            "success";

          setTimeout(() => {
            location.reload();
          }, 1000);

        } else if (response.status === 401) {

            message.textContent = "Please log in to add a tree.";

            message.className = "error";

          } else if (response.status === 403) {

            message.textContent =
              "You are not an admin. Please contact an admin to add a tree.";

            message.className =
              "error";

          } else {

            message.textContent =
              "Unable to add tree. Please try again.";

            message.className =
              "error";
          }

      } catch (error) {

        console.error(error);

        message.textContent =
          "Unable to connect to backend.";

        message.className =
          "error";

      }

    });

});

fetch(
  "/api/leaderboard"
)
  .then(
    response => response.json()
  )
  .then(data => {

    const container =
      document.getElementById(
        "leaderboard"
      );

    if (data.length === 0) {

      container.innerHTML =
        "No guardians yet";

      return;
    }

    container.innerHTML =
      data
        .map(
          (item, index) =>
            `
            <div>
              ${index + 1}.
              ${item.guardian}
              (${item.count})
            </div>
            `
        )
        .join("");

  });

fetch(
  "/api/analytics"
)
  .then(
    response => response.json()
  )
  .then(data => {

    document.getElementById(
      "healthy-card"
    ).innerHTML =
      `Healthy<br>${data.healthy}`;

    document.getElementById(
      "water-card"
    ).innerHTML =
      `Needs Water<br>${data.needs_water}`;

    document.getElementById(
      "broken-card"
    ).innerHTML =
      `Broken Branch<br>${data.broken_branch}`;

    document.getElementById(
      "pest-card"
    ).innerHTML =
      `Pest Infection<br>${data.pest_infection}`;

    document.getElementById(
      "illegal-card"
    ).innerHTML =
      `Illegal Cutting<br>${data.illegal_cutting}`;
  });

</script>