---
import MapView from "../components/MapView.astro";
---

<h1>🌳 GreenStreet</h1>

<div class="toolbar">

  <input
    id="species"
    type="text"
    placeholder="Tree species"
  />

  <div id="selected-location">
    Click on map to select location
  </div>

  <div id="message"></div>

  <input
    id="latitude"
    type="hidden"
  />

  <input
    id="longitude"
    type="hidden"
  />

  <button
    id="save-tree"
    type="button"
  >
    Add Tree
  </button>

</div>

<MapView />

<style>

.toolbar {
  margin: 1rem;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}

input {
  padding: 8px;
}

button {
  padding: 8px 12px;
  cursor: pointer;
}

#selected-location {
  font-weight: bold;
}

#message {
  min-height: 24px;
  font-weight: bold;
  margin-top: 5px;
}

.error {
  color: red;
}

.success {
  color: green;
}

</style>

<script>

window.addEventListener("load", () => {

  document
    .getElementById("save-tree")
    .addEventListener("click", async () => {

      const message =
        document.getElementById("message");

      message.textContent = "";
      message.className = "";

      const species =
        document.getElementById("species").value;

      if (
        !species ||
        species.trim().length === 0
      ) {

        message.textContent =
          "Please enter tree species.";

        message.className =
          "error";

        document
          .getElementById("species")
          .focus();

        return;
      }

      const latitude =
        parseFloat(
          document.getElementById("latitude").value
        );

      const longitude =
        parseFloat(
          document.getElementById("longitude").value
        );

      if (
        isNaN(latitude) ||
        isNaN(longitude)
      ) {

        message.textContent =
          "Please click on the map first.";

        message.className =
          "error";

        return;
      }

      try {

        const response =
          await fetch(
            "http://localhost:8000/trees",
            {
              method: "POST",
              headers: {
                "Content-Type":
                  "application/json"
              },
              body: JSON.stringify({
                species,
                latitude,
                longitude
              })
            }
          );

        if (response.ok) {

          message.textContent =
            "Tree added successfully.";

          message.className =
            "success";

          setTimeout(() => {
            location.reload();
          }, 1000);

        } else {

          message.textContent =
            "Failed to add tree.";

          message.className =
            "error";

        }

      } catch (error) {

        console.error(error);

        message.textContent =
          "Unable to connect to backend.";

        message.className =
          "error";

      }

    });

});

</script>