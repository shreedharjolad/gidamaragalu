---
import Dashboard from "../components/Dashboard.astro";
import Legend from "../components/Legend.astro";
import Filters from "../components/Filters.astro";
import MapView from "../components/MapView.astro";
import Login from "../components/Login.astro";
---

<h1>GreenStreet</h1>

<Login />

<Dashboard />

<div class="analytics">

  <div id="healthy-card"></div>

  <div id="water-card"></div>

  <div id="broken-card"></div>

  <div id="pest-card"></div>

  <div id="illegal-card"></div>

</div>

<h2>Top Guardians</h2>

<div id="leaderboard">
Loading...
</div>

<Legend />

<Filters />

<div class="toolbar">

  <input
    id="species"
    type="text"
    placeholder="Tree species"
  />

  <div id="selected-location">
    Click on map to select location
  </div>

  <div id="message"></div>

  <input
    id="latitude"
    type="hidden"
  />

  <input
    id="longitude"
    type="hidden"
  />

  <button
    id="save-tree"
    type="button"
  >
    Add Tree
  </button>

</div>

<MapView />

<style>

.toolbar {
  margin: 1rem;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}

input {
  padding: 8px;
}

button {
  padding: 8px 12px;
  cursor: pointer;
}

#selected-location {
  font-weight: bold;
}

#message {
  min-height: 24px;
  font-weight: bold;
  margin-top: 5px;
}

.error {
  color: red;
}

.success {
  color: green;
}

.analytics {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.analytics div {
  border: 1px solid #ccc;
  padding: 12px;
  min-width: 140px;
}

</style>

<script>

window.addEventListener("load", () => {

  document
    .getElementById("save-tree")
    .addEventListener("click", async () => {

      const message =
        document.getElementById("message");

      message.textContent = "";
      message.className = "";

      const species =
        document.getElementById("species").value;

      if (
        !species ||
        species.trim().length === 0
      ) {

        message.textContent =
          "Please enter tree species.";

        message.className =
          "error";

        document
          .getElementById("species")
          .focus();

        return;
      }

      const latitude =
        parseFloat(
          document.getElementById("latitude").value
        );

      const longitude =
        parseFloat(
          document.getElementById("longitude").value
        );

      if (
        isNaN(latitude) ||
        isNaN(longitude)
      ) {

        message.textContent =
          "Please click on the map first.";

        message.className =
          "error";

        return;
      }

      try {

        const token = localStorage.getItem("token");

        const response =
          await fetch(
            "http://localhost:8000/trees",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${token}`
              },
              body: JSON.stringify({
                species,
                latitude,
                longitude
              })
            }
          );

        if (response.ok) {

          message.textContent =
            "Tree added successfully.";

          message.className =
            "success";

          setTimeout(() => {
            location.reload();
          }, 1000);

        } else {

          message.textContent =
            "Failed to add tree.";

          message.className =
            "error";

        }

      } catch (error) {

        console.error(error);

        message.textContent =
          "Unable to connect to backend.";

        message.className =
          "error";

      }

    });

});

fetch(
  "http://localhost:8000/leaderboard"
)
  .then(
    response => response.json()
  )
  .then(data => {

    const container =
      document.getElementById(
        "leaderboard"
      );

    if (data.length === 0) {

      container.innerHTML =
        "No guardians yet";

      return;
    }

    container.innerHTML =
      data
        .map(
          (item, index) =>
            `
            <div>
              ${index + 1}.
              ${item.guardian}
              (${item.count})
            </div>
            `
        )
        .join("");

  });

fetch(
  "http://localhost:8000/analytics"
)
  .then(
    response => response.json()
  )
  .then(data => {

    document.getElementById(
      "healthy-card"
    ).innerHTML =
      `Healthy<br>${data.healthy}`;

    document.getElementById(
      "water-card"
    ).innerHTML =
      `Needs Water<br>${data.needs_water}`;

    document.getElementById(
      "broken-card"
    ).innerHTML =
      `Broken Branch<br>${data.broken_branch}`;

    document.getElementById(
      "pest-card"
    ).innerHTML =
      `Pest Infection<br>${data.pest_infection}`;

    document.getElementById(
      "illegal-card"
    ).innerHTML =
      `Illegal Cutting<br>${data.illegal_cutting}`;
  });

</script>