---
import "leaflet/dist/leaflet.css";
---

<div id="map"></div>

<style>
#map {
  width: 100%;
  height: 600px;
}
</style>

<script>
  import L from "leaflet";

  window.adoptTree = async function(treeId) {
    alert(`Adopt clicked for tree ${treeId}`);

    console.log(
      "adoptTree called",
      treeId
    );

  const guardian =
    prompt(
      "Enter your name:"
    );

  if (!guardian) {
    return;
  }

  const response =
    await fetch(
      `http://localhost:8000/trees/${treeId}/adopt`,
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/json"
        },
        body: JSON.stringify({
          guardian
        })
      }
    );

  if (response.ok) {

    alert(
      "Tree adopted successfully!"
    );

    location.reload();
  }

};

  window.addEventListener("load", () => {

    const map = L.map("map").setView(
      [17.3297, 76.8343],
      15
    );

    let selectedMarker = null;

    map.on("click", (event) => {

      const lat = event.latlng.lat;
      const lng = event.latlng.lng;

      document.getElementById("latitude").value = lat;
      document.getElementById("longitude").value = lng;

      document.getElementById(
        "selected-location"
      ).innerHTML =
        `Selected: ${lat.toFixed(5)}, ${lng.toFixed(5)}`;

      if (selectedMarker) {
        map.removeLayer(selectedMarker);
      }

      selectedMarker = L.marker([
        lat,
        lng
      ]).addTo(map);

    });

    L.tileLayer(
      "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        maxZoom: 19,
        attribution:
          "&copy; OpenStreetMap contributors"
      }
    ).addTo(map);

    // Fetch trees from backend
    fetch("http://localhost:8000/trees")
      .then(response => response.json())
      .then(trees => {

        trees.forEach(tree => {

          // Skip old trees without coordinates
          if (
            tree.latitude === null ||
            tree.longitude === null
          ) {
            return;
          }

          const marker = L.marker([
            tree.latitude,
            tree.longitude
          ])
          .addTo(map)
          .bindPopup(`
          <div style="
            min-width:220px;
            padding:8px;
          ">

          <h3>🌳 ${tree.species}</h3>

          <hr>

          <p><b>ID:</b> ${tree.id}</p>

          <p><b>Status:</b> ${tree.status}</p>

          <p>
          <b>Guardian:</b>
          ${tree.guardian || "None"}
          </p>

          <button
            id="adopt-btn-${tree.id}"
            data-tree-id="${tree.id}">
            Adopt Tree
          </button>

          </div>
          `);

          marker.on('popupopen', () => {
            const btn = document.getElementById(`adopt-btn-${tree.id}`);
            if (btn) {
              btn.addEventListener('click', (e) => {
                e.stopPropagation();
                window.adoptTree(tree.id);
              });
            }
          });
        });
      });
  });
</script>