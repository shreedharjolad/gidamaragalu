---
import "leaflet/dist/leaflet.css";
---

<div id="map"></div>

<style>
#map {
  width: 100%;
  height: 600px;
}

.leaflet-popup-content button {
  margin-right: 8px;
  margin-top: 8px;
  padding: 6px 10px;
  cursor: pointer;
}

.leaflet-popup-content button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.leaflet-div-icon {
  background: transparent !important;
  border: none !important;
  font-size: 28px;
}
</style>

<script>
import L from "leaflet";

const healthyIcon = L.divIcon({
  html: "🌳",
  className: "",
  iconSize: [30, 30]
});

const waterIcon = L.divIcon({
  html: "💧",
  className: "",
  iconSize: [30, 30]
});

const brokenIcon = L.divIcon({
  html: "⚠️",
  className: "",
  iconSize: [30, 30]
});

const pestIcon = L.divIcon({
  html: "🐛",
  className: "",
  iconSize: [30, 30]
});

const alertIcon = L.divIcon({
  html: "🚨",
  className: "",
  iconSize: [30, 30]
});

function getTreeIcon(status) {

  switch (status) {

    case "Needs Water":
      return waterIcon;

    case "Broken Branch":
      return brokenIcon;

    case "Pest Infection":
      return pestIcon;

    case "Illegal Cutting":
      return alertIcon;

    default:
      return healthyIcon;
  }
}

window.adoptTree = async function(treeId) {

  const guardian =
    prompt("Enter your name:");

  if (!guardian) {
    return;
  }

  const response =
    await fetch(
      `/api/trees/${treeId}/adopt`,
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/json"
        },
        body: JSON.stringify({
          guardian
        })
      }
    );

  const result =
    await response.json();

  if (result.error) {

    alert(result.error);

    return;
  }

  alert(
    "Tree adopted successfully!"
  );

  location.reload();
};

window.reportHealth =
async function(treeId) {

  const status =
    prompt(
      `Enter tree status:

      Healthy
      Needs Water
      Broken Branch
      Pest Infection
      Illegal Cutting`
      );

  if (!status) {
    return;
  }

  const response =
    await fetch(
      `/api/trees/${treeId}/report`,
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/json"
        },
        body: JSON.stringify({
          status
        })
      }
    );

  if (response.ok) {

    alert(
      "Health report submitted"
    );

    location.reload();
  } else {

    alert(
      "Failed to update health"
    );
  }
};

window.editTree = async function(treeId, currentSpecies, currentStatus) {

  const species = prompt("Species", currentSpecies);
  if (!species) return;

  const status = prompt("Status", currentStatus);
  if (!status) return;

  const token = localStorage.getItem("token");

  const response = await fetch(`/api/trees/${treeId}`, {
    method: "PUT",
    headers: {
      "Content-Type": "application/json",
      "Authorization": `Bearer ${token}`
    },
    body: JSON.stringify({ species, status })
  });

  if (response.ok) {
    alert("Tree updated");
    location.reload();
  } else {
    alert("Update failed");
  }
};

window.deleteTree = async function(treeId) {

  if (!confirm("Delete this tree?")) return;

  const token = localStorage.getItem("token");

  const response = await fetch(`/api/trees/${treeId}`, {
    method: "DELETE",
    headers: {
      "Authorization": `Bearer ${token}`
    }
  });

  if (response.ok) {
    alert("Tree deleted");
    location.reload();
  } else {
    alert("Delete failed");
  }
};

window.uploadPhoto =
async function(treeId) {

  console.log(
    "UPLOAD CLICKED",
    treeId
  );

  const input =
    document.getElementById(
      `photo-${treeId}`
    );

  console.log(
    "INPUT:",
    input
  );

  if (input) {

    console.log(
      "FILES:",
      input.files
    );

    console.log(
      "FILES LENGTH:",
      input.files.length
    );
  }

  if (
    !input ||
    !input.files ||
    input.files.length === 0
  ) {

    alert(
      "Please select a photo"
    );

    return;
  }

  const formData =
    new FormData();

  formData.append(
    "file",
    input.files[0]
  );

  console.log(
    "UPLOADING..."
  );

  const response =
    await fetch(
      `/api/trees/${treeId}/photo`,
      {
        method: "POST",
        body: formData
      }
    );

  console.log(
    "STATUS:",
    response.status
  );

  if (response.ok) {

    alert(
      "Photo uploaded!"
    );

    location.reload();

  } else {

    const text =
      await response.text();

    console.log(
      "ERROR:",
      text
    );

    alert(
      "Upload failed"
    );
  }

};

window.addEventListener("load", () => {

  document.addEventListener(
  "user-loaded",
  () => renderTrees()
  );

  let treeMarkers = [];
  let allTrees = [];

  const map =
    L.map("map")
      .setView(
        [17.3297, 76.8343],
        15
      );

  let selectedMarker = null;

  map.on("click", (event) => {

    const lat =
      event.latlng.lat;

    const lng =
      event.latlng.lng;

    document
      .getElementById("latitude")
      .value = lat;

    document
      .getElementById("longitude")
      .value = lng;

    document
      .getElementById(
        "selected-location"
      ).innerHTML =
        `Selected: ${lat.toFixed(5)}, ${lng.toFixed(5)}`;

    if (selectedMarker) {

      map.removeLayer(
        selectedMarker
      );
    }

    selectedMarker =
      L.marker(
        [lat, lng],
        {
          icon: healthyIcon
        }
      ).addTo(map);

  });

  L.tileLayer(
    "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      maxZoom: 19,
      attribution:
        "&copy; OpenStreetMap contributors"
    }
  ).addTo(map);

  function renderTrees() {

    treeMarkers.forEach(marker => {
      map.removeLayer(marker);
    });

    treeMarkers = [];

    const searchText =
      document
        .getElementById(
          "species-filter"
        )
        ?.value
        ?.toLowerCase() || "";

    const selectedStatuses =
      Array.from(
        document.querySelectorAll(
          ".status-filter:checked"
        )
      ).map(
        checkbox => checkbox.value
      );

    allTrees
      .filter(tree => {

        const speciesMatch =
          tree.species
            .toLowerCase()
            .includes(searchText);

        const statusMatch =
          selectedStatuses.includes(
            tree.status
          );

        return (
          speciesMatch &&
          statusMatch
        );
      })
      .forEach(tree => {

        const marker =
          L.marker(
            [
              tree.latitude,
              tree.longitude
            ],
            {
              icon:
                getTreeIcon(
                  tree.status
                )
            }
          )
          .addTo(map)
          .bindPopup(`
          <div style="
            min-width:220px;
            padding:8px;
          ">

          <h3>
          🌳 ${tree.species}
          </h3>

          <hr>

          <p>
          <b>ID:</b>
          ${tree.id}
          </p>

          ${
          tree.photo
          ?
          `
          <img
            src="${tree.photo}"
            style="
              width:100%;
              max-width:220px;
              border-radius:8px;
              margin-bottom:10px;
            "
          />
          `
          :
          `
          <p>No photo uploaded</p>
          `
          }

          <p>
          <b>Status:</b>
          ${tree.status}
          </p>

          <p>
          <b>Last Report:</b>
          ${
          tree.last_reported_at
          ?
          new Date(
          tree.last_reported_at
          ).toLocaleString()
          :
          "Never"
          }
          </p>

          <p>
            <b>Guardian:</b>
            ${tree.guardian || "None"}
          </p>

          ${
          tree.guardian
          ?
          `
          <button disabled>
          Already Adopted
          </button>
          `
          :
          `
          <button
          onclick="window.adoptTree(${tree.id})">
          Adopt Tree
          </button>
          `
          }

          <button
          onclick="window.reportHealth(${tree.id})">
          Report Health
          </button>

          ${
          window.currentUser?.role === "admin"
          ?
          `
          <button onclick="window.editTree(${tree.id}, '${tree.species}', '${tree.status}')">
          Edit
          </button>
          <button onclick="window.deleteTree(${tree.id})">
          Delete
          </button>
          `
          :
          ""
          }

          <hr>
          <input
          type="file"
          id="photo-${tree.id}"
          accept="image/*"
          />

          <br><br>

          <button
          onclick="window.uploadPhoto(${tree.id})">
          Upload Photo
          </button>

          </div>
          `)

        treeMarkers.push(
          marker
        );

      });

  }

  fetch(
    "/api/trees"
  )
    .then(
      response => response.json()
    )
    .then(trees => {

      allTrees =
        trees.filter(
          tree =>
            tree.latitude !== null &&
            tree.longitude !== null
        );

      renderTrees();

    });

document.addEventListener(
  "input",
  (event) => {

    if (
      event.target.id ===
        "species-filter" ||

      event.target.classList
        ?.contains(
          "status-filter"
        )
    ) {
      renderTrees();
    }

  }
);
});
</script>