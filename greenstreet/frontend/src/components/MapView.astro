<div id="map"></div>

<style>
#map {
  height: 600px;
}
</style>

<script>
import L from "leaflet";

const map = L.map("map")
.setView([19.0760,72.8777],13);

L.tileLayer(
'https://tile.openstreetmap.org/{z}/{x}/{y}.png'
).addTo(map);

L.marker([19.0760,72.8777])
.addTo(map)
.bindPopup("Neem Tree");
</script>