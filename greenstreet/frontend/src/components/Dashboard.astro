<div id="dashboard">

  <div class="card">
    <h3>Trees</h3>
    <p id="total-trees">0</p>
  </div>

  <div class="card">
    <h3>Adopted</h3>
    <p id="adopted-trees">0</p>
  </div>

  <div class="card">
    <h3>Need Water</h3>
    <p id="needs-water">0</p>
  </div>

  <div class="card">
    <h3>Alerts</h3>
    <p id="alerts">0</p>
  </div>

</div>

<style>
#dashboard {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin: 1rem;
}

.card {
  padding: 15px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: white;
  text-align: center;
  min-width: 0;
}

.card h3 {
  margin: 0;
  font-size: 18px;
}

.card p {
  font-size: 28px;
  font-weight: bold;
  margin: 12px 0 0;
}

/* Mobile */
@media (max-width: 768px) {
  #dashboard {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0.75rem;
  }

  .card {
    padding: 12px 8px;
  }

  .card h3 {
    font-size: 16px;
  }

  .card p {
    font-size: 24px;
  }
}
</style>

<script>

window.addEventListener("load", async () => {

  const response =
    await fetch(
      "/api/trees"
    );

  const trees =
    await response.json();

  const totalTrees =
    trees.length;

  const adoptedTrees =
    trees.filter(
      t => t.guardian
    ).length;

  const needsWater =
    trees.filter(
      t =>
      t.status ===
      "Needs Water"
    ).length;

  const alerts =
    trees.filter(
        t =>
        t.status === "Illegal Cutting" ||
        t.status === "Broken Branch" ||
        t.status === "Pest Infection"
    ).length;

  document
    .getElementById(
      "total-trees"
    )
    .textContent =
    totalTrees;

  document
    .getElementById(
      "adopted-trees"
    )
    .textContent =
    adoptedTrees;

  document
    .getElementById(
      "needs-water"
    )
    .textContent =
    needsWater;

  document
    .getElementById(
      "alerts"
    )
    .textContent =
    alerts;

});

</script>